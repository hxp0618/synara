{
  "name": "@synara/monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "scripts"
    ],
    "catalog": {
      "effect": "https://pkg.pr.new/Effect-TS/effect-smol/effect@8881a9b",
      "@effect/platform-node": "https://pkg.pr.new/Effect-TS/effect-smol/@effect/platform-node@8881a9b",
      "@effect/openapi-generator": "https://pkg.pr.new/Effect-TS/effect-smol/@effect/openapi-generator@8881a9b",
      "@effect/sql-sqlite-bun": "https://pkg.pr.new/Effect-TS/effect-smol/@effect/sql-sqlite-bun@8881a9b",
      "@effect/vitest": "https://pkg.pr.new/Effect-TS/effect-smol/@effect/vitest@8881a9b",
      "@effect/language-service": "0.75.1",
      "@types/bun": "^1.3.9",
      "@types/node": "^24.10.13",
      "ioredis": "^5.11.1",
      "tsdown": "^0.20.3",
      "typescript": "^5.7.3",
      "vitest": "^4.1.10"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-runner.ts dev",
    "dev:server": "node scripts/dev-runner.ts dev:server",
    "dev:web": "node scripts/dev-runner.ts dev:web",
    "dev:admin": "turbo run dev --filter=@synara/admin",
    "dev:marketing": "turbo run dev --filter=@synara/marketing",
    "dev:desktop": "node scripts/dev-runner.ts dev:desktop",
    "electron": "bun run start:desktop",
    "electron:dev": "node scripts/dev-runner.ts dev:desktop --home-dir ./.synara/electron-dev",
    "start": "turbo run start --filter=@synara/cli",
    "start:desktop": "turbo run start --filter=@synara/desktop",
    "start:marketing": "turbo run preview --filter=@synara/marketing",
    "start:admin": "turbo run start --filter=@synara/admin",
    "build": "turbo run build",
    "build:admin": "turbo run build --filter=@synara/admin",
    "build:marketing": "turbo run build --filter=@synara/marketing",
    "build:desktop": "turbo run build --filter=@synara/desktop --filter=@synara/cli",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --report-unused-disable-directives",
    "test": "turbo run test",
    "test:web:focused": "bun run --cwd apps/web test",
    "brand:check": "node scripts/check-brand-identity.ts",
    "migrations:check": "node scripts/check-migration-lineage.ts",
    "stage7:api:lint": "bunx @redocly/cli@2.43.3 lint --config docs/api/redocly.yaml docs/api/openapi.yaml",
    "stage7:sdk:check": "bun run --cwd packages/polaris-sdk generate:check && bun run --cwd packages/polaris-sdk typecheck && bun run --cwd packages/polaris-sdk test && bun run --cwd packages/polaris-sdk build",
    "stage7:python-sdk:generate": "bun scripts/generate-polaris-python-sdk.ts",
    "stage7:python-sdk:check": "bun scripts/generate-polaris-python-sdk.ts --check && python3 -m compileall -q packages/polaris-python/src packages/polaris-python/conformance examples/polaris/python && PYTHONPATH=packages/polaris-python/src python3 -m unittest discover -s packages/polaris-python/tests",
    "stage7:sdk:conformance": "go -C services/control-plane test ./internal/httpapi -run 'TestPolaris(TypeScript|Python)SDKAgainstRealControlPlane' -count=1 -v",
    "stage7:docs:build": "bun run --cwd apps/developer-docs build",
    "stage7:examples:check": "bash -n examples/polaris/curl/quickstart.sh && bun run --cwd packages/polaris-sdk tsc -- -p ../../examples/polaris/typescript/tsconfig.json",
    "stage7:sdk-release:check": "bun run --cwd scripts test lib/polaris-sdk-release.test.ts && PYTHONPATH=scripts python3 -m unittest scripts/test_verify_polaris_sdk_artifacts.py",
    "stage7:developer:check": "bun run stage7:api:lint && bun run stage7:sdk:check && bun run stage7:python-sdk:check && bun run stage7:examples:check && bun run stage7:sdk-release:check && bun run --cwd apps/developer-docs typecheck && bun run --cwd apps/developer-docs test && bun run stage7:docs:build",
    "examples:ci-fix": "bun examples/polaris/typescript/ci-fix-bot.ts",
    "examples:pr-review": "bun examples/polaris/typescript/pr-review-bot.ts",
    "examples:batch-migration": "bun examples/polaris/typescript/batch-migration.ts",
    "examples:python-ci-fix": "PYTHONPATH=packages/polaris-python/src python3 examples/polaris/python/ci_fix_bot.py",
    "stage6:compatibility:check": "python3 scripts/stage6-compatibility/validate_compatibility_matrix.py && python3 -m unittest scripts/stage6-compatibility/test_validate_compatibility_matrix.py",
    "stage6:capacity:prepare": "python3 scripts/stage6-capacity/prepare_capacity_evidence.py",
    "stage6:capacity:validate": "python3 scripts/stage6-capacity/validate_capacity_evidence.py",
    "stage6:cost:prepare": "python3 scripts/stage6-cost/prepare_internal_cost_evidence.py",
    "stage6:cost:validate": "python3 scripts/stage6-cost/validate_internal_cost_evidence.py",
    "stage6:candidate:prepare": "python3 scripts/stage6-candidate/prepare_candidate_evidence_bundle.py",
    "stage6:desktop:native:prepare": "python3 scripts/stage6-desktop/prepare_desktop_native_acceptance.py",
    "stage6:desktop:native:validate": "python3 scripts/stage6-desktop/validate_desktop_native_acceptance.py",
    "stage6:desktop:enrollment:prepare": "python3 scripts/stage6-desktop/prepare_desktop_enrollment_runtime_evidence.py",
    "stage6:desktop:mac:preflight": "node scripts/verify-mac-distribution-environment.ts",
    "stage6:documentation:validate": "python3 scripts/stage6-documentation/validate_documentation_set.py",
    "stage6:environment:baseline": "node scripts/apply-stage6-environment-baseline.ts",
    "stage6:environment:prepare": "node scripts/prepare-stage6-protected-environment-config.ts",
    "stage6:environment:apply": "node scripts/apply-stage6-protected-environment-config.ts",
    "stage6:engineering:check": "python3 scripts/stage6-engineering/run_stage6_engineering_checks.py",
    "stage6:final:validate": "python3 scripts/stage6-final/validate_final_ga_review.py",
    "stage6:final:prepare": "python3 scripts/stage6-final/prepare_final_ga_review.py",
    "stage6:branch-protection": "node scripts/apply-stage6-source-branch-protection.ts",
    "stage6:github:readiness": "node scripts/check-stage6-github-release-readiness.ts",
    "stage6:incident:prepare": "python3 scripts/stage6-incident/prepare_incident_exercise_evidence.py",
    "stage6:incident:validate": "python3 scripts/stage6-incident/validate_incident_exercise_evidence.py",
    "stage6:operations:prepare": "python3 scripts/stage6-operations/prepare_operations_exercise_evidence.py",
    "stage6:penetration:prepare": "python3 scripts/stage6-penetration/prepare_penetration_evidence.py",
    "stage6:penetration:validate": "python3 scripts/stage6-penetration/validate_penetration_evidence.py",
    "stage6:recovery:prepare": "python3 scripts/stage6-recovery/prepare_recovery_evidence.py",
    "stage6:recovery:validate": "python3 scripts/stage6-recovery/validate_recovery_evidence.py",
    "stage6:residency:prepare": "python3 scripts/stage6-residency/prepare_data_residency_evidence.py",
    "stage6:residency:validate": "python3 scripts/stage6-residency/validate_data_residency_evidence.py",
    "stage6:rotation:prepare": "python3 scripts/stage6-rotation/prepare_production_rotation_evidence.py",
    "stage6:rotation:validate": "python3 scripts/stage6-rotation/validate_production_rotation_evidence.py",
    "stage6:slo:prepare": "python3 scripts/stage6-slo/prepare_slo_evidence.py",
    "stage6:slo:validate": "python3 scripts/stage6-slo/validate_slo_evidence.py",
    "stage6:worker-supply-chain:validate": "python3 scripts/stage6-security/validate_worker_supply_chain_evidence.py",
    "test:desktop-smoke": "turbo run smoke-test --filter=@synara/desktop",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build:contracts": "turbo run build --filter=@synara/contracts",
    "dist:desktop:artifact": "node scripts/build-desktop-artifact.ts",
    "dist:desktop:dmg": "node scripts/build-desktop-artifact.ts --platform mac --target dmg",
    "dist:desktop:dmg:arm64": "node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch arm64",
    "dist:desktop:dmg:x64": "node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch x64",
    "dist:desktop:linux": "node scripts/build-desktop-artifact.ts --platform linux --target AppImage --arch x64",
    "dist:desktop:win": "node scripts/build-desktop-artifact.ts --platform win --target nsis --arch x64",
    "release:smoke": "node scripts/release-smoke.ts",
    "release:smoke:mac-update": "node scripts/smoke-mac-update-artifact.ts",
    "canary:setup": "node scripts/canary.ts setup",
    "canary:update": "node scripts/canary.ts update",
    "canary:start": "node scripts/canary.ts start",
    "canary:stop": "node scripts/canary.ts stop",
    "canary:status": "node scripts/canary.ts status",
    "canary:rollback": "node scripts/canary.ts rollback",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules scripts/node_modules apps/*/dist apps/*/dist-electron packages/*/dist .turbo apps/*/.turbo packages/*/.turbo"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "turbo": "^2.9.14",
    "vitest": "catalog:"
  },
  "overrides": {
    "axios": "^1.16.0",
    "defu": "^6.1.5",
    "effect": "https://pkg.pr.new/Effect-TS/effect-smol/effect@8881a9b",
    "fast-uri": "^3.1.2",
    "follow-redirects": "^1.16.0",
    "form-data": "^4.0.6",
    "hono": "^4.12.25",
    "ip-address": "^10.2.0",
    "joi": "^18.2.1",
    "lodash": "^4.18.1",
    "postcss": "^8.5.10",
    "protobufjs": "^7.6.3",
    "qs": "^6.15.2",
    "smol-toml": "^1.6.1",
    "uuid": "^13.0.1",
    "vite": "^8.1.4",
    "ws": "^8.21.0",
    "yaml": "^2.8.3"
  },
  "engines": {
    "bun": "^1.3.9",
    "node": "^24.13.1"
  },
  "packageManager": "bun@1.3.12",
  "msw": {
    "workerDirectory": [
      "apps/web/public"
    ]
  },
  "patchedDependencies": {
    "@effect/platform-node-shared@https://pkg.pr.new/Effect-TS/effect-smol/@effect/platform-node-shared@8881a9b606d84a6f5eb6615279138322984f5368": "patches/@effect%2Fplatform-node-shared@8881a9b.patch"
  }
}
