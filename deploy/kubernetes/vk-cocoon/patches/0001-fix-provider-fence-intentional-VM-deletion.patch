+func TestDeletePodDetachesVMRemovalFromRequestCancellation(t *testing.T) {
+	rt := &fakeRuntime{}
+	p := newTestProvider(t)
+	p.Runtime = rt
+	pod := newPodWithSpec(meta.VMSpec{VMName: "vk-ns-demo-0", SnapshotPolicy: "never"})
+	p.trackPod(pod, &vm.VM{ID: "vmid-del", Name: "vk-ns-demo-0"})
+
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	if err := p.DeletePod(ctx, pod); err != nil {
+		t.Fatalf("DeletePod: %v", err)
+	}
+	if rt.removeCtxErr != nil {
+		t.Fatalf("Runtime.Remove context was already canceled: %v", rt.removeCtxErr)
+	}
+}
+
+func TestHandleVMGoneSkipsIntentionalDeleteInFlight(t *testing.T) {
+	rt := &fakeRuntime{}
+	p := newTestProvider(t)
+	p.Runtime = rt
+	pod := newPodWithSpec(meta.VMSpec{VMName: "vk-ns-demo-0", SnapshotPolicy: "never"})
+	p.trackPod(pod, &vm.VM{ID: "vmid-del", Name: "vk-ns-demo-0"})
+
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	var once sync.Once
+	rt.onRemove = func() {
+		once.Do(func() { close(entered) })
+		<-release
+	}
+	done := make(chan error, 1)
+	go func() { done <- p.DeletePod(t.Context(), pod) }()
+	<-entered
+
+	p.handleVMGone(t.Context(), &vm.VM{ID: "vmid-del", Name: "vk-ns-demo-0"})
+	if rt.inspectN != 0 {
+		t.Fatalf("intentional delete event triggered %d inspect calls", rt.inspectN)
+	}
+	close(release)
+	if err := <-done; err != nil {
+		t.Fatalf("DeletePod: %v", err)
+	}
+}
