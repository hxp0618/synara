+func (p *Provider) markVMDeleting(vmID string) func() {
+	p.mu.Lock()
+	p.deletingVMs[vmID]++
+	p.mu.Unlock()
+	return func() {
+		p.mu.Lock()
+		if p.deletingVMs[vmID]--; p.deletingVMs[vmID] == 0 {
+			delete(p.deletingVMs, vmID)
+		}
+		p.mu.Unlock()
+	}
+}
+
+func (p *Provider) vmDeleting(vmID string) bool {
+	p.mu.RLock()
+	deleting := p.deletingVMs[vmID] > 0
+	p.mu.RUnlock()
+	return deleting
+}
