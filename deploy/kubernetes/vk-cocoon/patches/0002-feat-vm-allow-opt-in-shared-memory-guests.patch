 			opts: RunOptions{Image: "ghcr.io/x/y:1", Name: "vm-f", CPU: 2, Memory: "4Gi", Storage: "20Gi", Network: "cocoon-dhcp"},
diff --git a/vm/runtime.go b/vm/runtime.go
index 6e278d5..201678f 100644
--- a/vm/runtime.go
+++ b/vm/runtime.go
@@ -129,6 +129,9 @@ type RunOptions struct {
