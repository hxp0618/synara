# Copy into <operator-root>/REPLACE_TARGET_UUID/observability.env with mode
# 0600 or 0640 and a non-writable parent directory. The Worker is deliberately
# credentialless: an external relay/service mesh owns collector client identity.
# Header tokens and client certificate/key paths are unsupported.
OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com/v1/traces
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Leave empty when the collector chains to a public trust root.
OTEL_EXPORTER_OTLP_CERTIFICATE=
SYNARA_OTEL_TRACE_SAMPLE_RATIO=0.1
SYNARA_OTEL_COLLECTOR_REGION=REPLACE_REGION
SYNARA_OTEL_TRACE_RETENTION_DAYS=30
