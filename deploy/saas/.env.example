# Required secrets. Generate independent values for each deployment.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=synara
MINIO_ROOT_PASSWORD=
SYNARA_AUTH_TOKEN=
SYNARA_WORKER_REGISTRATION_TOKEN=
# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
SYNARA_PROVIDER_CURSOR_KEY=
# Authenticated Provider Cursors older than this are quarantined and rebuilt
# from authoritative Session history. Maximum supported value: 8760h.
SYNARA_PROVIDER_CURSOR_MAX_AGE=720h
# Short-lived Worker/Generation-bound authorization for an already frozen
# Provider Credential. Lease renew transports it, but only semantic Session
# activity extends refresh authority; heartbeats never count as activity.
SYNARA_PROVIDER_CREDENTIAL_ACCESS_TTL=5m
# UUID of the dedicated platform-operations Tenant allowed to append the
# shared provider tariff catalog, seal shared Target ledger coverage, and own
# shared-allocation scheduler audits. Ordinary customer Tenant owners remain
# unable to change platform-global billing authority.
SYNARA_BILLING_TARIFF_OPERATOR_TENANT_ID=

# Actual cloud invoice import. Disabled is the safe default. s3, gcs, and
# azure use their SDK default credential/workload-identity chain. Every cloud
# mapping must pin an immutable objectVersion (S3 VersionId, GCS generation,
# or Azure version ID); never put cloud credentials in the mapping JSON.
SYNARA_BILLING_BLOB_SOURCE=disabled
SYNARA_BILLING_LOCAL_BASE_DIR=
SYNARA_BILLING_S3_BUCKET=
SYNARA_BILLING_S3_REGION=us-east-1
SYNARA_BILLING_S3_ENDPOINT=
SYNARA_BILLING_S3_USE_PATH_STYLE=false
SYNARA_BILLING_S3_ALLOW_CUSTOM_ENDPOINT=false
SYNARA_BILLING_S3_ALLOW_HTTP=false
SYNARA_BILLING_GCS_BUCKET=
SYNARA_BILLING_AZURE_CONTAINER_URL=
SYNARA_BILLING_AZURE_ALLOW_HTTP=false
SYNARA_BILLING_BLOB_PREFIX=
# 0 selects the bounded 16 MiB runtime default; it does not disable the limit.
SYNARA_BILLING_MAX_OBJECT_BYTES=0
SYNARA_BILLING_IMPORT_MAPPINGS_JSON=[]
# Each item is either one explicit static closed period or a monthly-utc schedule.
# Static requires RFC3339 billingPeriodStartAt/billingPeriodEndAt. monthly-utc
# requires an exact UTC firstPeriodStartAt month boundary and accepts an optional
# lastPeriodEndAt boundary. Both require executionTargetId, provider, currencyCode,
# settlementDelay (1m..2160h), and scheduleInterval (>=1m). Examples:
# [{"executionTargetId":"...","provider":"aws","currencyCode":"USD","billingPeriodStartAt":"2026-07-01T00:00:00Z","billingPeriodEndAt":"2026-08-01T00:00:00Z","settlementDelay":"24h","scheduleInterval":"6h"}]
# [{"executionTargetId":"...","provider":"aws","currencyCode":"USD","calendar":"monthly-utc","firstPeriodStartAt":"2026-01-01T00:00:00Z","settlementDelay":"24h","scheduleInterval":"6h"}]
SYNARA_BILLING_SHARED_ALLOCATION_MAPPINGS_JSON=[]

# PostgreSQL pool and bounded concurrent-startup migration coordination.
SYNARA_DATABASE_MAX_OPEN_CONNECTIONS=20
SYNARA_DATABASE_MAX_IDLE_CONNECTIONS=5
SYNARA_DATABASE_CONNECTION_MAX_LIFETIME=1h
SYNARA_DATABASE_CONNECTION_MAX_IDLE_TIME=15m
SYNARA_DATABASE_MIGRATION_LOCK_TIMEOUT=30s

# Provider Credential envelope encryption. The Compose default uses a local
# 32-byte KEK; production may switch the provider to aws-kms and configure an
# AWS KMS key ID/region instead of a local master key.
SYNARA_CREDENTIAL_KMS_PROVIDER=local
SYNARA_CREDENTIAL_KMS_KEY_ID=single-node-local-v1
SYNARA_CREDENTIAL_MASTER_KEY=
SYNARA_CREDENTIAL_KMS_AWS_REGION=
# Explicit single-node opt-in for the Control Plane's AWS SDK default chain
# (KMS and/or billing). These names prevent accidental inheritance of the
# operator shell's generic AWS_* credentials. Prefer workload identity in Kubernetes.
SYNARA_CONTROL_PLANE_AWS_ACCESS_KEY_ID=
SYNARA_CONTROL_PLANE_AWS_SECRET_ACCESS_KEY=
SYNARA_CONTROL_PLANE_AWS_SESSION_TOKEN=

# Public HTTPS origin that SSH/Kubernetes Workers use to call the control plane.
SYNARA_PUBLIC_CONTROL_PLANE_URL=
SYNARA_SSH_PROVISION_TIMEOUT=2m
SYNARA_DOCKER_RECONCILE_INTERVAL=10s
SYNARA_KUBERNETES_RECONCILE_INTERVAL=5s
# Server-authoritative threshold for classifying an exact current Pod as pending-timeout.
# Must be at least the Kubernetes reconcile interval and no greater than 24h.
SYNARA_KUBERNETES_POD_PENDING_FAILURE_THRESHOLD=2m
# Signed platform/integration routing publishers. Store public keys only; the
# matching Ed25519 private keys stay in the external publisher workload.
# Each target is exact-owner scoped. DR routes are exact source/destination pairs.
# [{"publisherIdentity":"routing-prod","keys":[{"keyId":"v1","ed25519PublicKey":"BASE64_PUBLIC_KEY"}],"targets":[{"executionTargetId":"UUID","ownership":"platform-shared","publishHealth":true,"drRoutes":[{"sourceDrDomain":"region-a/cluster-a","drDomain":"region-b/cluster-b"}]}]}]
SYNARA_PLATFORM_ROUTING_PUBLISHERS_JSON=[]
SYNARA_WORKER_AUTO_ROLLBACK_ENABLED=true
SYNARA_WORKER_AUTO_ROLLBACK_INTERVAL=10s
SYNARA_RETENTION_SWEEP_INTERVAL=1h
# Leader-scoped exact terminal Worker fact rollup. Pending facts remain visible until committed.
SYNARA_METRIC_ROLLUP_INTERVAL=1m
SYNARA_METRIC_ROLLUP_BATCH_SIZE=500
SYNARA_OUTBOX_POLL_INTERVAL=500ms
SYNARA_OUTBOX_CLAIM_TTL=30s
SYNARA_OUTBOX_BATCH_SIZE=50
SYNARA_OUTBOX_MAX_ATTEMPTS=12
SYNARA_OUTBOX_BASE_BACKOFF=1s
SYNARA_OUTBOX_MAX_BACKOFF=5m
SYNARA_SSE_POLL_INTERVAL=2s
SYNARA_SSE_HEARTBEAT_INTERVAL=15s
SYNARA_SSE_WRITE_TIMEOUT=10s
SYNARA_SSE_LEASE_TTL=45s
SYNARA_SSE_MAX_CONNECTIONS_PER_USER=4
SYNARA_SSE_MAX_CONNECTIONS_PER_TENANT=200

# Used only with docker-workers.override.yml. On Linux, set the numeric group
# that owns the Docker socket (`stat -c %g /var/run/docker.sock`).
SYNARA_DOCKER_SOCKET_PATH=/var/run/docker.sock
SYNARA_DOCKER_GID=0

# MinIO/S3 Artifact Store. The public endpoint is embedded in presigned URLs and
# must be reachable by the browser or API client.
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_PUBLIC_HOST=127.0.0.1
MINIO_HOST_PORT=59000
SYNARA_ARTIFACT_BUCKET=synara-artifacts
SYNARA_ARTIFACT_REGION=us-east-1
SYNARA_ARTIFACT_PRESIGN_TTL=15m
SYNARA_ARTIFACT_MAX_UPLOAD_BYTES=2147483648
SYNARA_ARTIFACT_CORS_ALLOW_ORIGIN=http://127.0.0.1:3773

# This Compose deployment is the supported v1 single-node profile.
SYNARA_DEPLOYMENT_PROFILE=single-node
SYNARA_METADATA_STORE=postgresql
SYNARA_ARTIFACT_STORE=minio
SYNARA_QUEUE_DRIVER=postgres-outbox
SYNARA_CONTROL_PLANE_REPLICAS=1
SYNARA_WORKER_LEASES_ENABLED=true
SYNARA_WORKER_FENCING_ENABLED=true

# The temporary local identity bootstrap is useful for development and acceptance testing.
# Keep it false in production and configure an OIDC or SAML identity connection instead.
SYNARA_CONTROL_PLANE_DEV_BOOTSTRAP=false
SYNARA_LOGIN_COOKIE_SECURE=true
SYNARA_LOGIN_COOKIE_DOMAIN=
SYNARA_LOGIN_COOKIE_PATH=/
SYNARA_LOGIN_COOKIE_SAME_SITE=lax
SYNARA_LOGIN_SESSION_TTL=720h
SYNARA_LOGIN_SESSION_IDLE_TTL=168h
# Comma-separated CIDRs of reverse proxies allowed to supply X-Forwarded-For.
SYNARA_TRUSTED_PROXY_CIDRS=
SYNARA_WORKER_LEASE_TTL=30s
SYNARA_WORKER_HEARTBEAT_TIMEOUT=90s
SYNARA_WORKER_RECEIPT_TTL=24h

# Public Synara listener.
SYNARA_BIND_ADDRESS=127.0.0.1
SYNARA_HOST_PORT=3773

# Host workspace mounted into the existing TypeScript Provider Runtime.
SYNARA_WORKSPACE_PATH=./workspace
SYNARA_UID=1000
SYNARA_GID=1000
SYNARA_IMAGE=synara-saas:local

# Optional Go module proxy for networks that cannot reach proxy.golang.org.
GOPROXY=https://proxy.golang.org,direct

# Optional prefix for GitHub Release downloads during the Synara image build.
GITHUB_DOWNLOAD_PREFIX=
